# Copy to .env.local for local work. On Vercel, add these under Settings > Environment Variables.

# ── Public (already in .env; visible in the browser by design) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
NEXT_PUBLIC_CLAYPOT_PAY=false

# ── Secret: emails (Resend) ──
RESEND_API_KEY=
MAIL_FROM=The Dinerworkshop <hello@thedinerworkshop.com>
REPLY_TO=thedinerworkshop@gmail.com
NOTIFY_EMAIL=thedinerworkshop@gmail.com
SITE_URL=https://www.thedinerworkshop.com

# ── Secret: claypot payments (Stripe), only when payments are switched on ──
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
